<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Servicing -->
    <PackageVersion Include="Microsoft.Dism" Version="6.1.0" />
    <PackageVersion Include="System.Diagnostics.EventLog" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Management.Infrastructure" Version="3.0.0" />

    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />

    <!-- App -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />

    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
