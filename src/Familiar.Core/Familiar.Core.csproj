<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(FamiliarTargetFramework)</TargetFramework>
    <RootNamespace>Familiar.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Dism" />
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="Microsoft.Management.Infrastructure" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Familiar.Core.Tests" />
  </ItemGroup>

  <!-- Offline fallback for release data; refresh with eng/Update-ReleaseSnapshot.ps1. -->
  <ItemGroup>
    <EmbeddedResource Include="Releases\Snapshot\*.json" LogicalName="Familiar.Core.Releases.Snapshot.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
