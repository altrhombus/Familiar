<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Familiar.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Familiar">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="Familiar" />
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            PaneDisplayMode="Left"
            SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Source image" Icon="OpenFile" Tag="Source" />
                <NavigationViewItem Content="Updates" Icon="Sync" Tag="Updates" />
                <NavigationViewItem Content="Languages" Icon="Globe" Tag="Languages" />
                <NavigationViewItem Content="Drivers" Icon="Repair" Tag="Drivers" />
                <NavigationViewItem Content="Apps" Icon="AllApps" Tag="Apps" />
                <NavigationViewItem Content="Customizations" Icon="Edit" Tag="Customizations" />
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Configuration Manager" Icon="Upload" Tag="ConfigMgr" />
                <NavigationViewItem Content="Build" Icon="Save" Tag="Build" />
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar
                    x:Name="ElevationBar"
                    Title="Administrator rights needed"
                    Margin="24,12,24,0"
                    IsClosable="False"
                    Message="Mounting and servicing images uses the DISM API, which requires an elevated process."
                    Severity="Warning">
                    <InfoBar.ActionButton>
                        <Button Click="RestartElevated_Click" Content="Restart as administrator" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
